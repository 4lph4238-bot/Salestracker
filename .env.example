# Copy this file to .env and fill in real values.
# Never commit the real .env file to version control.

PORT=5000

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=sales_tracker
# Set to "true" for managed hosts that require SSL (e.g. Aiven). Leave unset for local MySQL.
DB_SSL=false

# Use a long, random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_long_random_secret

# Percentage (0-1) of a loan's total value that, if paid on the date of
# purchase, immediately counts the sale's revenue/profit in reports even
# before the loan is fully repaid. e.g. 0.5 = 50%
LOAN_SETTLEMENT_THRESHOLD=0.5
